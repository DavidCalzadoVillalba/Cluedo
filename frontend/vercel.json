{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TU-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/v3/api-docs/:path*",
      "destination": "https://TU-BACKEND.onrender.com/v3/api-docs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
